# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public site URL used for metadataBase, canonical URLs and Open Graph tags.
# In production set this to the canonical public origin, e.g. https://vibechops.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack inline fallback (public key only; never put a secret key here)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Environment
NODE_ENV=development
