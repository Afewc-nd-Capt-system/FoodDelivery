# ===========================================
# VibeChops Environment Variables
# ===========================================
# Copy this to .env and fill in all values

# ===================
# SERVER
# ===================
NODE_ENV=development
PORT=5000

# ===================
# MONGODB
# ===================
MONGODB_URI=mongodb://localhost:27017/food-delivery

# ===================
# REDIS (Optional - falls back gracefully)
# ===================
REDIS_URL=redis://localhost:6379

# ===================
# JWT & AUTH
# ===================
# Generate each value separately: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-separate-48-byte-secret>
JWT_REFRESH_SECRET=<generate-a-different-48-byte-secret>
DISABLE_MFA=false

# ===================
# SEED (local/development only)
# ===================
ENABLE_SEED=false
SEED_KEY=<generate-a-seed-key>
SEED_CLEAR_TOKEN=<generate-a-clear-data-token>
SEED_ADMIN_PASSWORD=<set-a-strong-password>
SEED_DEMO_PASSWORD=<set-a-strong-password>
SEED_VENDOR_PASSWORD=<set-a-strong-password>
SEED_RESTAURANT_PASSWORD=<set-a-strong-password>
SEED_RIDER_PASSWORD=<set-a-strong-password>
SEED_DELIVERY_PASSWORD=<set-a-strong-password>
SEED_COMPANY_PASSWORD=<set-a-strong-password>

# ===================
# PAYSTACK PAYMENTS
# ===================
PAYSTACK_SECRET_KEY=<paystack-secret-key>
PAYSTACK_PUBLIC_KEY=<paystack-public-key>

# ===================
# EMAIL (Nodemailer)
# ===================
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# ===================
# FILE UPLOADS (Optional)
# ===================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ===================
# SECURITY
# ===================
HCAPTCHA_SECRET=your-hcaptcha-secret-key
DISABLE_RATE_LIMIT=false
DISABLE_MFA=false

# ===================
# FRONTEND URLs
# ===================
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000
# Comma-separated exact browser origins. In production the default is
# https://food-delivery-app-ten-beta.vercel.app when this is unset.
ALLOWED_ORIGINS=http://localhost:3000

# ===================
# DEBUG (Development only)
# ===================
DEBUG=false
LOG_LEVEL=info

# ===================
# HAVE I BEEN PWNED (Optional)
# ===================
HIBP_API_KEY=your-hibp-api-key-optional